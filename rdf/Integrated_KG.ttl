mdhn_data:ChehelSotoun a mdhn:MonumentOrBuilding ;
    rdfs:label "Chehel Sotoun Palace"@en ;
    rdfs:comment "Safavid palace in Isfahan."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:Isfahan .

mdhn_data:EdwardBrowne a mdhn:IntellectualOrator ;
    rdfs:label "Edward Granville Browne"@en ;
    rdfs:comment "British Orientalist; Curzon references contemporary scholarly and political observations on Persia."@en ;
    owl:sameAs wd:Q1293375 ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 .

mdhn_data:Enzeli a mdhn:City ;
    rdfs:label "Enzeli"@en ;
    rdfs:comment "Main Caspian port of Gilan; Russian-controlled landing place for trade and potential railway access."@en ;
    skos:altLabel "Bandar-e Anzali"@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:locatedIn mdhn_data:CaspianSea,
        mdhn_data:Gilan ;
    mdhn:sourcePageReference "Vol. 1 printed pages 27, 28, 31, 183, 353, 360, 370, 375, 381, 385, 467, 472, 600, 620, 626, 639; exact label occurrence in the page-marked Frank Cass 1966 transcription; lexical evidence only, verify the claim against the 1892 scan." .

mdhn_data:EuphratesValleyRailway a mdhn:RevolutionaryEvent ;
    rdfs:label "Euphrates Valley / Indo-Mediterranean Railway Schemes"@en ;
    rdfs:comment "Historical proposals for a railway from the Mediterranean to the Persian Gulf, analysed and largely rejected by Curzon."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 .

mdhn_data:FathAliShah a mdhn:Monarch ;
    rdfs:label "Fath-Ali Shah Qajar"@en ;
    rdfs:comment "Second Qajar Shah; referenced in connection with early 19th-century wars with Russia and the loss of Caucasian territories."@en ;
    owl:sameAs wd:Q202076 ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 .

mdhn_data:FirstTravelToEurope a mdhn:TravelToEurope ;
    rdfs:label "First Travel To Europe"@en ;
    mdhn:basedOnEvidence mdhn_data:FirstTravelToEuropeEvidence ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:occuredOn mdhn:Temporal_1873 ;
    mdhn:occuredAt mdhn_data:Europe;
    mdhn:participatedIn mdhn_data:NaserAlDinShah .

mdhn_data:FredericGoldsmid a mdhn:IntellectualOrator ;
    rdfs:label "Sir Frederic Goldsmid"@en ;
    rdfs:comment "British officer who led the Seistan Boundary Commission and wrote on eastern Persia; cited by Curzon."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 .

mdhn_data:GeographicalBarriers a mdhn:SpatialEntity ;
    rdfs:label "Geographical Barriers to Communication and Development"@en ;
    rdfs:comment "Curzon's detailed analysis of mountain ranges (Alborz, Zagros), deserts, climate, and the resulting difficulties of internal transport, which shaped both political control and railway possibilities."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 .

mdhn_data:GovernorOfAstrabad a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Astrabad"@en ;
    rdfs:comment "Governor of the Caspian province of Astrabad (modern Gorgan), a sensitive frontier facing Russian Turkmenia and the Transcaspian Railway. Curzon discusses its strategic position and local conditions."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:identificationStatus "role-only" ;
    mdhn:locatedIn mdhn_data:Astrabad ;
    mdhn:participatedIn mdhn_data:GreatGameCompetition,
        mdhn_data:TranscaspianRailwayImpact .

mdhn_data:GovernorOfBushire a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Bushire"@en ;
    rdfs:comment "Local governor or political agent at the principal Persian Gulf port of Bushire, controlling customs, trade, and relations with the British residency."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:Bushire,
        mdhn_data:PersianGulf ;
    mdhn:participatedIn mdhn_data:BritishTradeSouth .

mdhn_data:GovernorOfHamadan a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Hamadan"@en ;
    rdfs:comment "Local governor of Hamadan, a key station on the Baghdad–Tehran caravan and potential railway route. Curzon records observations on the town and its administration while travelling the western approaches."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:locatedIn mdhn_data:Hamadan ;
    mdhn:sourcePageReference "Vol. 1 printed pages 423; exact label occurrence in the page-marked Frank Cass 1966 transcription; lexical evidence only, verify the claim against the 1892 scan." .

mdhn_data:GovernorOfKerman a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Kerman"@en ;
    rdfs:comment "Governor of the southeastern province of Kerman, an important commercial centre linking central Persia with Seistan, Baluchistan, and the Gulf routes. Curzon discusses trade, industry (shawls, carpets), and the strategic position of the region."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:Kerman .

mdhn_data:GovernorOfMohammerah a mdhn:HistoricalPerson ;
    rdfs:label "Governor / Sheikh of Mohammerah"@en ;
    rdfs:comment "Local ruler or governor at Mohammerah (Khorramshahr) at the head of the Karun River; key figure for British trade concessions and southern access."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:KarunRiver,
        mdhn_data:Mohammerah ;
    mdhn:participatedIn mdhn_data:BritishTradeSouth .

mdhn_data:GovernorOfResht a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Resht / Gilan"@en ;
    rdfs:comment "Provincial governor of Gilan, responsible for the Caspian littoral, the port of Enzeli/Resht, and the silk and transit trade with Russia. The post was sensitive because of Russian naval and commercial monopoly on the Caspian."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:holdsOffice mdhn_data:OfficeGovernorGilan ;
    mdhn:identificationStatus "role-only" ;
    mdhn:locatedIn mdhn_data:Gilan,
        mdhn_data:Resht ;
    mdhn:participatedIn mdhn_data:GreatGameCompetition .

mdhn_data:GovernorOfSeistan a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Seistan"@en ;
    rdfs:comment "Local governor of the eastern border province of Seistan (Sistan). Important for Anglo-Russian boundary questions, trade routes toward India, and potential railway corridors."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:identificationStatus "role-only" ;
    mdhn:locatedIn mdhn_data:Seistan ;
    mdhn:participatedIn mdhn_data:GreatGameCompetition .

mdhn_data:GovernorOfShiraz a mdhn:HistoricalPerson ;
    rdfs:label "Governor of Shiraz / Fars"@en ;
    rdfs:comment "Provincial governor of Fars, overseeing Shiraz and the southern districts that controlled routes toward the Persian Gulf and the major Achaemenid and Sasanian sites. Curzon notes local administration and conditions during his journey through Fars."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:Fars,
        mdhn_data:Shiraz .

mdhn_data:GovernorOfTabriz a mdhn:HistoricalPerson,
        mdhn:MilitaryLeader ;
    rdfs:label "Governor of Tabriz / Azerbaijan"@en ;
    rdfs:comment "The provincial governor of Azerbaijan (based in Tabriz), one of the most important commercial and strategic posts in Qajar Persia due to proximity to Russia and the Caucasian trade routes. Curzon discusses the Russian commercial and political influence operating through this governorship."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:locatedIn mdhn_data:Azerbaijan,
        mdhn_data:Tabriz ;
    mdhn:participatedIn mdhn_data:GreatGameCompetition .

mdhn_data:HenryDrummondWolff a mdhn:HistoricalPerson ;
    rdfs:label "Sir Henry Drummond Wolff"@en ;
    rdfs:comment "British diplomat and special envoy; involved in Persian negotiations and referenced in the context of British policy."@en ;
    skos:altLabel "هنری دروموند ولف"@fa ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
