mdhn:Office a rdfs:Class ;
    rdfs:label "Administrative Office or Post"@en ;
    rdfs:subClassOf mdhn:SpatialEntity .

mdhn:hasPopulationEstimate a owl:DatatypeProperty ;
    rdfs:label "has population estimate"@en ;
    rdfs:domain mdhn:SpatialEntity ;
    rdfs:range xsd:string .

mdhn:hasRevenueEstimate a owl:DatatypeProperty ;
    rdfs:label "has revenue estimate"@en ;
    rdfs:domain mdhn:SpatialEntity ;
    rdfs:range xsd:string .

mdhn:holdsOffice a owl:ObjectProperty ;
    rdfs:label "holds office"@en ;
    rdfs:domain mdhn:HistoricalPerson ;
    rdfs:range mdhn:Office .

mdhn:identificationStatus a owl:DatatypeProperty ;
    rdfs:label "identification status"@en ;
    rdfs:comment "Values: named, role-only, inferred" ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

mdhn:metWith a owl:ObjectProperty ;
    rdfs:label "met with / interviewed"@en ;
    rdfs:domain mdhn:HistoricalPerson ;
    rdfs:range mdhn:HistoricalPerson .

mdhn:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:domain mdhn:SpatialEntity ;
    rdfs:range mdhn:SpatialEntity .

mdhn_data:AbakaKhan a mdhn:HistoricalPerson ;
    rdfs:label "Abaka Khan"@en ;
    rdfs:comment "Mongol prince identified by Curzon as the son of Hulaku Khan and great-grandson of Jenghiz Khan."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1, p. 505 (page-marked 1966 transcription)." .

mdhn_data:AbbasKuliKhan a mdhn:HistoricalPerson ;
    rdfs:label "Abbas Kuli Khan"@en ;
    rdfs:comment "Turkish chieftain described by Curzon as restored as ruler of Nishapur."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1, p. 263 (page-marked 1966 transcription)." .

mdhn_data:AbbasMirza a mdhn:MilitaryLeader ;
    rdfs:label "Abbas Mirza"@en ;
    rdfs:comment "Crown prince and military reformer under Fath-Ali Shah; key figure in the Russo-Persian wars."@en ;
    owl:sameAs wd:Q307512 ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1 printed pages 42, 98, 100, 109, 159, 160, 192, 196, 272, 281, 288, 393, 394, 395, 398, 409, 412, 422, 437, 521, 522, 523, 524, 525, 528, 558, 576, 577, 578, 579, 580, 581, 582, 609, 639; exact label occurrence in the page-marked Frank Cass 1966 transcription; lexical evidence only, verify the claim against the 1892 scan." .

mdhn_data:AbdurRahmanKhan a mdhn:HistoricalPerson ;
    rdfs:label "Abdur Rahman Khan"@en ;
    rdfs:comment "Afghan amir discussed by Curzon in relation to Afghanistan's policy toward Persia."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1, pp. 45, 216 (page-marked 1966 transcription)." .

mdhn_data:AbdusSamedMirza a mdhn:HistoricalPerson ;
    rdfs:label "Abdus Samed Mirza"@en ;
    rdfs:comment "Qajar prince identified by Curzon as the Izz-ed-Dowleh and a former Minister of Justice."@en ;
    skos:altLabel "Izz-ed-Dowleh"@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1, p. 423 (page-marked 1966 transcription)." .

mdhn_data:AbulHasanKhanGhaffari a mdhn:HistoricalPerson ;
    rdfs:label "Abul Hasan Khan Ghaffari"@en ;
    rdfs:comment "Artist whose paintings are noted by Curzon in his description of the Shah's palace."@en ;
    skos:altLabel "Sani-el-Mulk"@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1, p. 317 (page-marked 1966 transcription)." .

mdhn_data:AghaMohammadKhan a mdhn:MilitaryLeader,
        mdhn:Monarch ;
    rdfs:label "Agha Mohammad Khan Qajar"@en ;
    rdfs:comment "Founder of the Qajar dynasty; frequently referenced for the establishment of the dynasty and early 19th-century history."@en ;
    owl:sameAs wd:Q204645 ;
    skos:altLabel "Agha Mohammed Khan Kajar"@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:sourcePageReference "Vol. 1, pp. 151, 165, 187 (Curzon spelling variant; page-marked 1966 transcription)." .

mdhn_data:AminAlSultan a mdhn:FinancialAdministrator ;
    rdfs:label "Mirza Ali Asghar Khan Amin al-Sultan"@en ;
    rdfs:comment "Grand Vizier and dominant political figure during the later years of Naser al-Din Shah. Central to concession policy (including Reuter and later tobacco-related affairs) and the management of foreign relations with Britain and Russia. Curzon analyses his role in the court and the distribution of power."@en,
        "Powerful Qajar minister and multiple-time prime minister under Naser al-Din Shah; frequently discussed in context of court and concessions."@en ;
    owl:sameAs wd:Q957636 ;
    skos:altLabel "Amin al-Sultan"@en,
        "Amin-e Soltan"@en,
        "Atabak-e Azam"@en,
        "Mirza Ali Asghar Khan Amin al-Sultan"@en,
        "اتابک اعظم"@fa,
        "میرزا علی‌اصغر خان امین‌السلطان"@fa ;
    mdhn:describedInBook mdhn_data:Ch_ForeignPolicy,
        mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:heldOffice "Grand Vizier / Amin al-Sultan" ;
    mdhn:identificationStatus "named" ;
    mdhn:participatedIn mdhn_data:QajarCourtPolitics,
        mdhn_data:RussianEconomicDominance .

mdhn_data:ArthurNicolson a mdhn:HistoricalPerson ;
    rdfs:label "Sir Arthur Nicolson"@en ;
    rdfs:comment "British diplomat; served in Tehran and was involved in Anglo-Persian relations during the period."@en ;
    skos:altLabel "آرتور نیکلسون"@fa ;
    mdhn:describedInBook mdhn_data:CurzonVol1 .

mdhn_data:BaghdadTehranRoute a mdhn:RevolutionaryEvent ;
    rdfs:label "Baghdad-Tehran Route and Proposed Railway"@en ;
    rdfs:comment "Western land route via Kermanshah and Hamadan; merchandise and passenger traffic discussed."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:occurredAt mdhn_data:Hamadan,
        mdhn_data:Tehran .

mdhn_data:Baku a mdhn:City ;
    rdfs:label "Baku"@en ;
    rdfs:comment "Caspian oil port and Russian railhead; possible starting point for northern railways into Persia."@en ;
    owl:sameAs wd:Q9248 ;
    mdhn:describedInBook mdhn_data:CurzonVol1 ;
    mdhn:sourcePageReference "Vol. 1 printed pages 27, 28, 32, 56, 59, 61, 62, 65, 66, 67, 71, 72, 186, 187, 208, 359, 366, 373, 374, 466, 527, 617, 626, 639; exact label occurrence in the page-marked Frank Cass 1966 transcription; lexical evidence only, verify the claim against the 1892 scan." .

mdhn_data:BaronJuliusDeReuter a mdhn:FinancialAdministrator ;
    rdfs:label "Baron Julius de Reuter"@en ;
    rdfs:comment "German-born British financier who received the comprehensive 1872 Reuter Concession."@en ;
    skos:altLabel "Paul Julius Reuter"@en,
        "بارون جولیوس دو رویتر"@fa ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:sourcePageReference "Detailed analysis in railway and concession chapters of Vol. 1." .

mdhn_data:BritishResidentGulf a mdhn:HistoricalPerson ;
    rdfs:label "British Resident in the Persian Gulf"@en ;
    rdfs:comment "The British political resident at Bushire or on the Gulf, representing British interests in southern Persia and the maritime frontier."@en ;
    mdhn:describedInBook mdhn_data:CurzonVol1,
        mdhn_data:CurzonVol2 ;
    mdhn:locatedIn mdhn_data:Bushire,
        mdhn_data:PersianGulf ;
    mdhn:participatedIn mdhn_data:BritishTradeSouth .

